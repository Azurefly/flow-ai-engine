FLOW_HTTP_PORT=1180
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex
FLOW_BOOTSTRAP_ADMIN_USERNAME=flow_admin
FLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional OpenAI-compatible provider for LLM workflow nodes.
# Keep the real key only in the deployment .env or secret manager; never commit it.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
# Trusted deployment-owned pricing catalog. Values are micro-currency units per
# one million tokens; keep blank until the operator supplies current provider prices.
# LLM_MODEL_PRICING_JSON={"model-id":{"inputMicrosPerMillionTokens":0,"outputMicrosPerMillionTokens":0}}
LLM_MODEL_PRICING_JSON=

# Build/deployment identity and durable workflow worker.
BUILD_SHA=unknown
BUILD_TIME=unknown
IMAGE_DIGEST=unknown
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_POLL_MS=1000
WORKFLOW_WORKER_LEASE_SECONDS=120
