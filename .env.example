FLOW_HTTP_PORT=1180
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex
FLOW_BOOTSTRAP_ADMIN_USERNAME=flow_admin
FLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional OpenAI-compatible provider for LLM workflow nodes.
# Keep the real key only in the deployment .env or secret manager; never commit it.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
